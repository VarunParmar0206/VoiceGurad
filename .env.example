# VoiceGuard V2 — Environment Variables
# Copy this file to .env and fill in the required values.
# NEVER commit .env to version control.

# ── Database ─────────────────────────────────────────────────────────────
VG_DATABASE_URL=postgresql+asyncpg://voiceguard:voiceguard@localhost:5432/voiceguard
VG_REDIS_URL=redis://localhost:6379/0

# ── Security (REQUIRED — no defaults) ───────────────────────────────────
VG_JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
VG_ENCRYPTION_KEY=CHANGE_ME_TO_A_BASE64_FERNET_KEY

# ── Application ──────────────────────────────────────────────────────────
VG_DEBUG=false
VG_LOG_LEVEL=INFO
VG_HOST=0.0.0.0
VG_PORT=8000

# ── Client ───────────────────────────────────────────────────────────────
VG_CLIENT_API_BASE_URL=http://localhost:8000
